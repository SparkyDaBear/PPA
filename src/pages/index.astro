---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Treatment Explorer · Proteomics Perturbation Atlas">
  <section class="explorer-header">
    <div>
      <p class="hero-kicker">Proteomics Perturbation Atlas</p>
      <h2>Treatment Explorer</h2>
      <p class="lede">Choose a broad perturbation category, a treatment class, and an evidence-mapped fine-grained bucket to browse its annotated studies.</p>
    </div>
    <p id="browser-total" class="explorer-total" aria-live="polite">Loading treatment annotations...</p>
  </section>

  <section id="treatment-browser" class="treatment-explorer" aria-label="Treatment ontology explorer" data-url={`${base}export/treatment_browser.json`} data-base={base}>
    <div class="treatment-column">
      <div class="explorer-section-heading"><p class="detail-kicker">Level 1</p><h3>Treatment categories</h3></div>
      <div id="treatment-l1" class="treatment-l1-list" aria-live="polite"></div>
    </div>
    <div class="treatment-column treatment-l2-column">
      <div class="explorer-section-heading"><p class="detail-kicker">Level 2</p><h3 id="treatment-l2-title">Choose a category</h3></div>
      <div id="treatment-l2" class="treatment-l2-list" aria-live="polite"></div>
    </div>
    <div class="treatment-column treatment-l3-column">
      <div class="explorer-section-heading"><p class="detail-kicker">Level 3</p><h3 id="treatment-l3-title">Choose a treatment class</h3></div>
      <div id="treatment-l3" class="treatment-l3-list" aria-live="polite"></div>
    </div>
  </section>

  <section class="treatment-results" aria-label="Annotated project results">
    <header class="results-header">
      <div><p class="detail-kicker">Studies</p><h3 id="results-title">Select a treatment class</h3><p id="results-definition" class="row-meta">Select a Level 2 class to see all studies, then optionally refine them with Level 3.</p></div>
      <p id="results-count" class="explorer-total"></p>
    </header>
    <label class="search-field results-filter"><span>Filter studies</span><input id="treatment-project-filter" type="search" placeholder="PXD, title, treatment agent, cell system, or assay" disabled /></label>
    <div class="treatment-results-layout">
      <div id="treatment-projects" class="treatment-project-list" aria-live="polite"></div>
      <aside id="treatment-project-detail" class="treatment-project-detail" aria-live="polite"><p class="detail-kicker">Project metadata</p><h3>Select a study</h3><p class="row-meta">Choose a project to inspect its treatment context, experimental design, and source links.</p></aside>
    </div>
  </section>

  <script>
    import { initTreatmentBrowser } from '../scripts/treatment-browser';
    const browser = document.getElementById('treatment-browser');
    initTreatmentBrowser({
      dataUrl: browser?.dataset.url || '/export/treatment_browser.json',
      baseUrl: browser?.dataset.base || '/',
    });
  </script>
</BaseLayout>